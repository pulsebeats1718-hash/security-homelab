# Copy to .env (never commit .env). Expo inlines EXPO_PUBLIC_* values into the app
# bundle, so NEVER put secrets here — the Nuance and Anthropic keys live only in the Worker.

# Base URL of the Sophie Worker (backend/). Must be HTTPS on a real phone, or
# http://localhost:8787 together with `adb reverse tcp:8787 tcp:8787` for local dev.
EXPO_PUBLIC_API_BASE_URL=https://sophie-backend.<your-subdomain>.workers.dev

# Optional. Must match APP_CLIENT_KEY on the Worker if you set one. Not a secret.
EXPO_PUBLIC_APP_CLIENT_KEY=
