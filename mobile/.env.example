# Sophie app configuration.
#
# 1. Copy this file:   Copy-Item .env.example .env
# 2. Edit .env (git-ignored).
#
# EVERYTHING HERE IS PUBLIC. Expo compiles EXPO_PUBLIC_* values into the app,
# where anyone can read them. NEVER put the Nuance or Anthropic API keys here —
# they belong only in the Cloudflare Worker (see docs/credentials.md).
# `npm start` / `npm run android` refuse to run if a key-like value is found.

# URL of your deployed Sophie Worker (HTTPS), or http://localhost:8787 with `adb reverse`.
EXPO_PUBLIC_API_BASE_URL=https://sophie-backend.your-subdomain.workers.dev

# OPTIONAL. Must equal APP_CLIENT_KEY on the Worker. A speed bump, not a secret.
EXPO_PUBLIC_APP_CLIENT_KEY=
