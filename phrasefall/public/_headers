# Cache rules for Netlify and Cloudflare Pages (Firebase Hosting uses firebase.json instead).
# The page, the manifest and the service worker are always re-checked, so a new deploy reaches
# installed copies of the app; files in /assets/ have hashed names, so they can be cached for good.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
