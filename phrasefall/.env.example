# Phrasefall online features: Google sign-in, cloud save and leaderboards (Firebase).
# Copy this file to .env.local and fill in the values from the Firebase console:
#   Project settings → General → Your apps → (your Web app) → SDK setup and configuration → Config
# Step by step: DEPLOY.md.
#
# These values are compiled into the public JavaScript, which is normal for Firebase web apps:
# what players can do is controlled by firestore.rules and the Authentication settings.
# Leave the four required values empty to build the game without online features.
# The single-file preview build (npm run build:single) never includes them.

# required
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local development against the Firebase Emulator Suite (firebase emulators:start):
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
