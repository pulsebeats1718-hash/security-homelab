# Sophie backend — LOCAL DEVELOPMENT ONLY (`npm run dev`).
#
# 1. Copy this file:   Copy-Item .env.example .env
# 2. Put real values in .env (never in this file). .env is git-ignored.
# 3. Production does NOT read this file. Deployed secrets are set with
#    `npx wrangler secret put <NAME>` — see docs/credentials.md.

# REQUIRED. Your Nuance Labs API key (starts with "nk_"). Server-side only.
NUANCE_API_KEY=replace-with-your-nuance-api-key

# REQUIRED. Any long random string; used to hash device ids before they reach Nuance.
END_USER_SALT=replace-with-a-long-random-string

# OPTIONAL. Anthropic API key; enables post-call reviews. Leave empty to disable.
ANTHROPIC_API_KEY=

# OPTIONAL. Must equal EXPO_PUBLIC_APP_CLIENT_KEY in mobile/.env. Not a secret.
APP_CLIENT_KEY=
